# Zero OS Development Environment Configuration
# Copy this file to .env and configure with your actual development values

# ===========================================
# APPLICATION URLS (Development)
# ===========================================
VITE_PUBLIC_APP_URL=http://localhost:3500
VITE_PUBLIC_BACKEND_URL=http://localhost:8787

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/zerodotemail"

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your_32_character_random_string_here
BETTER_AUTH_URL=http://localhost:8787
COOKIE_DOMAIN=localhost

# ===========================================
# GOOGLE OAUTH (Required)
# ===========================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_oauth_client_secret

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_URL=http://localhost:8079
REDIS_TOKEN=upstash-local-token

# ===========================================
# EMAIL SERVICE (Required)
# ===========================================
RESEND_API_KEY=re_your_resend_api_key

# ===========================================
# AI SERVICES (Required: Google Generative AI)
# ===========================================
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy_your_google_ai_api_key
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash

# ===========================================
# OPTIONAL AI SERVICES
# ===========================================
OPENAI_API_KEY=sk_your_openai_key_if_using
PERPLEXITY_API_KEY=pplx-your_perplexity_key_if_using
USE_OPENAI=false
OPENAI_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini

# ===========================================
# AI SYSTEM PROMPT (Optional)
# ===========================================
AI_SYSTEM_PROMPT="You are Zero, a helpful AI assistant for managing emails, calendar, and other productivity tasks efficiently."

# ===========================================
# CLOUDFLARE CONFIGURATION (Development/Testing)
# ===========================================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# ===========================================
# CLOUDFLARE RESOURCES (Development)
# ===========================================
CF_VECTORIZE_INDEX_THREADS=threads-vector-development
CF_VECTORIZE_INDEX_MESSAGES=messages-vector-development
CF_R2_BUCKET_THREADS=threads-development
CF_QUEUE_THREAD=thread-queue-development
CF_QUEUE_SUBSCRIBE=subscribe-queue-development
CF_QUEUE_SEND_EMAIL=send-email-queue-development

# ===========================================
# COMMUNICATION SERVICES (Optional)
# ===========================================
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ===========================================
# TESTING & DEVELOPMENT
# ===========================================
PLAYWRIGHT_SESSION_TOKEN=your_playwright_session_token
PLAYWRIGHT_SESSION_DATA=your_playwright_session_data
EMAIL=your_test_email@example.com

# ===========================================
# ENVIRONMENT
# ===========================================
NODE_ENV=development