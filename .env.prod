# Production Environment Configuration for Zero Email
# Copy this file to .env and fill in your actual values

# Application URLs
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_BACKEND_URL=https://yourdomain.com

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=zerodotemail
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@db:5432/zerodotemail

# Authentication
BETTER_AUTH_SECRET=your_better_auth_secret_32_chars_min
BETTER_AUTH_URL=https://yourdomain.com
COOKIE_DOMAIN=yourdomain.com

# Redis Configuration
REDIS_URL=http://localhost:8079
REDIS_TOKEN=your_redis_token

# Email Service
RESEND_API_KEY=your_resend_api_key

# AI Services
OPENAI_API_KEY=your_openai_api_key
PERPLEXITY_API_KEY=your_perplexity_api_key
OPENAI_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini
AI_SYSTEM_PROMPT=You are a helpful AI assistant for managing emails.

# ElevenLabs (if using voice features)
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Twilio (if using SMS features)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Autumn (file storage)
AUTUMN_SECRET_KEY=your_autumn_secret_key

# Environment
NODE_ENV=production
