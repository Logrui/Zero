# Zero OS Production Environment Configuration
# Copy this file to .env and configure with your actual production values

# ===========================================
# MIGRATION NOTE: Zero OS uses Vite (not Next.js)
# ===========================================
# If migrating from original Zero Email (Next.js), run:
# pnpm exec nizzy fix-env
# This will automatically convert NEXT_PUBLIC_* to VITE_PUBLIC_*

# ===========================================
# APPLICATION URLS (Update for your domain)
# ===========================================
VITE_PUBLIC_APP_URL=https://yourdomain.com
VITE_PUBLIC_BACKEND_URL=https://api.yourdomain.com

# Legacy compatibility (will be auto-converted):
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
# NEXT_PUBLIC_BACKEND_URL=https://api.yourdomain.com

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_very_secure_production_password
POSTGRES_DB=zerodotemail
DATABASE_URL=postgresql://postgres:your_very_secure_production_password@db:5432/zerodotemail

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=generate_32_character_random_string_here
BETTER_AUTH_URL=https://api.yourdomain.com
COOKIE_DOMAIN=yourdomain.com

# ===========================================
# GOOGLE OAUTH (Required)
# ===========================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_oauth_client_secret

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_URL=http://upstash-proxy:80
REDIS_TOKEN=your_secure_production_redis_token

# ===========================================
# EMAIL SERVICE (Required)
# ===========================================
RESEND_API_KEY=re_your_actual_resend_api_key

# ===========================================
# AI SERVICES (Required: Google Generative AI)
# ===========================================
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy_your_actual_google_ai_api_key
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash

# ===========================================
# OPTIONAL AI SERVICES
# ===========================================
OPENAI_API_KEY=sk-your_openai_key_if_using_openai
PERPLEXITY_API_KEY=pplx-your_perplexity_key_if_using
USE_OPENAI=false
OPENAI_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini

# ===========================================
# AI SYSTEM PROMPT (Optional)
# ===========================================
AI_SYSTEM_PROMPT="You are Zero, a helpful AI assistant for managing emails efficiently."

# ===========================================
# CLOUDFLARE CONFIGURATION (Required)
# ===========================================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_with_workers_permissions
WRANGLER_API_TOKEN=your_cloudflare_api_token_with_workers_permissions

# ===========================================
# CLOUDFLARE RESOURCES (Production)
# ===========================================
CF_VECTORIZE_INDEX_THREADS=threads-vector-production
CF_VECTORIZE_INDEX_MESSAGES=messages-vector-production
CF_R2_BUCKET_THREADS=threads-production
CF_QUEUE_THREAD=thread-queue-production
CF_QUEUE_SUBSCRIBE=subscribe-queue-production
CF_QUEUE_SEND_EMAIL=send-email-queue-production

# ===========================================
# COMMUNICATION SERVICES (Optional)
# ===========================================
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ===========================================
# TESTING & DEVELOPMENT
# ===========================================
PLAYWRIGHT_SESSION_TOKEN=your_playwright_session_token
PLAYWRIGHT_SESSION_DATA=your_playwright_session_data
EMAIL=test@yourdomain.com

# ===========================================
# ENVIRONMENT
# ===========================================
NODE_ENV=production
