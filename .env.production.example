# Zero OS Production Environment Configuration
# Copy this file to .env and configure with your actual production values

# ===========================================
# MIGRATION NOTE: Zero OS uses Vite (not Next.js)
# ===========================================
# If migrating from original Zero Email (Next.js), run:
# pnpm exec nizzy fix-env
# This will automatically convert NEXT_PUBLIC_* to VITE_PUBLIC_*

# ===========================================
# APPLICATION URLS (Docker container setup)
# ===========================================
VITE_PUBLIC_APP_URL=http://localhost:3500
VITE_PUBLIC_BACKEND_URL=http://localhost:8787


# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zerodotemail
DATABASE_URL=postgresql://postgres:postgres@db:5432/zerodotemail

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your_secret_key_here_32_chars_minimum
BETTER_AUTH_URL=http://localhost:8787
COOKIE_DOMAIN=localhost

# ===========================================
# GOOGLE OAUTH (Required)
# ===========================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_URL=http://upstash-proxy:80
REDIS_TOKEN=upstash-local-token

# ===========================================
# EMAIL SERVICE (Required)
# ===========================================
RESEND_API_KEY=your_resend_api_key_here

# ===========================================
# AI SERVICES (Required: Google Generative AI)
# ===========================================
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_api_key_here
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash

# ===========================================
# OPTIONAL AI SERVICES
# ===========================================
OPENAI_API_KEY=
PERPLEXITY_API_KEY=your_perplexity_api_key_here
USE_OPENAI=false
OPENAI_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini

# ===========================================
# AI SYSTEM PROMPT (Optional)
# ===========================================
AI_SYSTEM_PROMPT="You are Zero, a helpful AI assistant for managing emails efficiently."

# ===========================================
# CLOUDFLARE CONFIGURATION (Required)
# ===========================================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
WRANGLER_API_TOKEN=your_wrangler_api_token_here

# ===========================================
# CLOUDFLARE RESOURCES (Production)
# ===========================================
CF_VECTORIZE_INDEX_THREADS=threads-vector-production
CF_VECTORIZE_INDEX_MESSAGES=messages-vector-production
CF_R2_BUCKET_THREADS=threads-production
CF_QUEUE_THREAD=thread-queue-production
CF_QUEUE_SUBSCRIBE=subscribe-queue-production
CF_QUEUE_SEND_EMAIL=send-email-queue-production

# ===========================================
# COMMUNICATION SERVICES (Optional)
# ===========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ===========================================
# TESTING & DEVELOPMENT
# ===========================================
PLAYWRIGHT_SESSION_TOKEN=
PLAYWRIGHT_SESSION_DATA=


NODE_ENV="production"


POSTGRES_PASSWORD=your-secure-password
UPSTASH_TOKEN=your-secure-token
TUNNEL_TOKEN=your-cloudflare-tunnel-token