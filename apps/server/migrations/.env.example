# Zero OS Notifications Database Configuration
# Copy this file to .env and update with your database settings

# Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zero_notifications
DB_USER=zero_user
DB_PASSWORD=your_secure_password

# Security Settings
DB_SSL=false

# Production Settings (uncomment and configure for production)
# DB_HOST=your-prod-db-host.com
# DB_SSL=true
# DB_PASSWORD=very_secure_production_password

# Migration Settings
MIGRATION_TIMEOUT=30000
MIGRATION_LOCK_TIMEOUT=10000

# Logging
LOG_LEVEL=info
LOG_MIGRATIONS=true